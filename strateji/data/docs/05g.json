    { "id": "kurulum", "title": "8 · Kurulum Adımları", "summary": "Sıra.", "blocks": [ { "type": "list", "ordered": true, "items": ["clarity.microsoft.com'da proje oluştur.", "GTM galerisinden Clarity şablonunu kur (All Pages).", "Hassas form alanlarını maskele; consent'e bağla.", "Kayıt/heatmap dolmaya başlayınca haftalık inceleme ritmi kur."] } ]},
    { "id": "kampanya-mimarisi", "title": "9 · Analiz Mimarisi", "summary": "Hangi araçlar?", "blocks": [
