      { "id": "isi-haritasi", "title": "Isı Haritası", "summary": "Nereye tıklanıyor?", "blocks": [ { "type": "list", "items": ["Tıklama/hareket yoğunluğu; ölü tıklama, rage-click.", "Aksiyon: kritik CTA'ları görünür bölgeye taşı."] } ]},
      { "id": "oturum-kaydi", "title": "Oturum Kaydı", "summary": "Gerçek davranış.", "blocks": [ { "type": "list", "items": ["Dönüşmeyen/hata alan oturumlara odaklan.", "Haftada 10-15 kayıt → UX bulgu listesi.", "Maskeleme + yetki sınırı."] } ]},
      { "id": "scroll-form", "title": "Scroll & Form Analizi", "summary": "Nereye kadar, hangi alan?", "blocks": [ { "type": "list", "items": ["Scroll map: içeriğin görülen kısmı.", "Form: terk ettiren alan → sadeleştir."] } ]}
