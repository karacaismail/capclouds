  "sections": [
    { "id": "yonetici-ozeti", "title": "1 · Yönetici Özeti", "summary": "Hangi kararı üretir?", "blocks": [
      { "type": "paragraph", "text": "**Microsoft Clarity ücretsizdir** ve GTM galerisinden hızlı kurulur; ısı haritası + oturum kaydı + kaydırma haritası verir. Yandex Metrica Webvisor ile birlikte veya alternatif olarak UX iyileştirme döngüsünü besler. Karar: hemen kur (GO). Hotjar ücretli/opsiyoneldir." }
    ]},
    { "id": "is-gerekcesi", "title": "2 · İş Gerekçesi", "summary": "Neden gerekli?", "blocks": [
      { "type": "list", "items": ["Reklam trafiğini boşa harcamamak için açılış sayfası UX'i kritik.", "'Neden dönüşmedi' sorusunu ısı haritası + kayıt gösterir.", "Clarity ücretsiz → düşük bütçede yüksek değer."] }
    ]},
    { "id": "mevcut-durum", "title": "3 · Mevcut Durum ve Eksikler", "summary": "Bugün ne var?", "blocks": [
      { "type": "evidence", "items": [ { "claim": "Sitede oturum kaydı/ısı haritası aracı yok", "confidence": "fact", "sourceId": "S1" }, { "claim": "GTM kurulu (kolay kurulum)", "confidence": "fact", "sourceId": "S1" } ] }
    ]},
    { "id": "hedef-kitle", "title": "4 · Hangi Sorulara Cevap?", "summary": "Kullanım senaryosu.", "blocks": [
      { "type": "list", "items": ["Franchise/iletişim formunda nerede vazgeçiliyor?", "Mobilde CTA görülüyor mu (rage-click var mı)?", "Menü/şube sayfasında ne kadar aşağı iniliyor?"] }
    ]},
    { "id": "funnel-gorevi", "title": "5 · Funnel Görevi", "summary": "Aşama.", "blocks": [ { "type": "paragraph", "text": "UX ölçüm katmanı — tüm funnel'ın açılış sayfalarındaki davranışı görünür kılar; dönüşüm optimizasyonunu besler." } ]},
