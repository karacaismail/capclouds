    { "id": "yonetici-ozeti", "title": "1 · Yönetici Özeti", "summary": "Hangi kararı üretir?", "blocks": [
      { "type": "paragraph", "text": "Site WordPress + Elementor + Yoast; **online mağaza yok** (shop/cart 404) ve Elementor yükü mobil hızı düşürüyor. İki iş: (1) hızlandır + gerçek mobil-öncelik, (2) WooCommerce ile paketli kahve/merch sat — bu tüm katalog/retargeting/Merchant Center'ın önünü açar." },
      { "type": "decision", "gate": "CONDITIONAL_GO", "rationale": "E-ticaret büyük fırsat ama operasyonel yük (kargo, iade, stok) getirir; önce hız + küçük ürün seti.", "condition": "Kargo/ödeme/iade operasyonu netleşince mağaza GO (Faz 4).", "owner": "Tolga", "decisionOwner": "Genel Müdür", "deadline": "Faz 4" }
    ]},
    { "id": "is-gerekcesi", "title": "2 · İş Gerekçesi", "summary": "Neden değişmeli?", "blocks": [
      { "type": "list", "items": ["Mobil hız = reklam veriminin ve SEO'nun temeli.", "Online satış = yeni gelir + 'markayı eve götür' bağı.", "Katalog olmadan Merchant/Criteo/dinamik reklam açılamaz."] }
    ]},
    { "id": "mevcut-durum", "title": "3 · Mevcut Durum ve Eksikler", "summary": "Bugün ne var?", "blocks": [
      { "type": "evidence", "items": [ { "claim": "WordPress + Elementor + Yoast; Hostinger + Cloudflare", "confidence": "fact", "sourceId": "S1" }, { "claim": "shop/cart/checkout 404 → mağaza yok", "confidence": "fact", "sourceId": "S1" }, { "claim": "Ana sayfa HTML ~420 KB + çok görsel → mobil hız riski", "confidence": "estimate", "sourceId": "S1", "note": "PageSpeed ölçümü önerilir" } ] }
    ]},
    { "id": "hedef-kitle", "title": "4 · Kullanım Senaryosu", "summary": "Kim, ne yapacak?", "blocks": [
      { "type": "list", "items": ["Paketli kavrulmuş kahve alan tüketici", "Merch (kupa/ekipman) alan sadık müşteri", "Hediye seti arayan"] }
    ]},
